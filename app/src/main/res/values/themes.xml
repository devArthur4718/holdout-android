<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The window behind the Compose content. It follows day/night (values-night), so dark mode
         never flashes white while the first screen is drawn. -->
    <style name="Theme.Holdout" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- The launch screen: the arc on Holdout purple. Then the activity switches to Theme.Holdout.
         core-splashscreen gives the same screen on Android 8–11 as on 12+. -->
    <style name="Theme.Holdout.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Holdout</item>
    </style>
</resources>
